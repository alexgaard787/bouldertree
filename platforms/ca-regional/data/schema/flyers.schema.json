{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/alexgaard787/bouldertree/main/platforms/ca-regional/data/schema/flyers.schema.json",
  "title": "CA regional flyer feed (flyers.json)",
  "description": "Regional and World Council flyers inherited by every group fork. Each item has either a 'placeholder' (rendered as an SVG) or a 'src' (a repo-relative image/PDF path or data URI). Flyers must show no last names, full-face photos, or personal contacts. Past-event flyers are moved from items[] to archive[] by scripts/archive-flyers.js once eventEndDate has passed (Blueprint Automation #6).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "isSample",
    "items",
    "archive"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "isSample": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "title",
          "category",
          "eventDate",
          "eventEndDate",
          "alt"
        ],
        "oneOf": [
          {
            "required": [
              "placeholder"
            ]
          },
          {
            "required": [
              "src"
            ]
          }
        ],
        "properties": {
          "id": {
            "$ref": "common.defs.json#/$defs/slug"
          },
          "source": {
            "$ref": "common.defs.json#/$defs/source"
          },
          "title": {
            "$ref": "common.defs.json#/$defs/safeText"
          },
          "category": {
            "enum": [
              "Unity / Campouts",
              "Workshops / Speakers",
              "Area / Service",
              "Other"
            ]
          },
          "eventDate": {
            "$ref": "common.defs.json#/$defs/verifiableDate"
          },
          "eventEndDate": {
            "$ref": "common.defs.json#/$defs/verifiableDate",
            "description": "Last day of the event. When it is a real date in the past, archive-flyers.js moves the flyer to archive[]."
          },
          "alt": {
            "$ref": "common.defs.json#/$defs/safeText"
          },
          "src": {
            "type": "string",
            "pattern": "^(flyers/[a-z0-9-]+\\.(png|jpe?g|svg|pdf)|data:(image/(png|jpeg|svg\\+xml)|application/pdf)[;,])"
          },
          "placeholder": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "heading",
              "subheading",
              "color"
            ],
            "properties": {
              "heading": {
                "type": "string",
                "maxLength": 40
              },
              "subheading": {
                "type": "string",
                "maxLength": 60
              },
              "note": {
                "type": "string",
                "maxLength": 60
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              }
            }
          }
        }
      }
    },
    "archive": {
      "type": "array",
      "description": "Past-event flyers (newest first).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "title",
          "category",
          "eventDate",
          "eventEndDate",
          "alt",
          "archivedOn"
        ],
        "oneOf": [
          {
            "required": [
              "placeholder"
            ]
          },
          {
            "required": [
              "src"
            ]
          }
        ],
        "properties": {
          "id": {
            "$ref": "common.defs.json#/$defs/slug"
          },
          "source": {
            "$ref": "common.defs.json#/$defs/source"
          },
          "title": {
            "$ref": "common.defs.json#/$defs/safeText"
          },
          "category": {
            "enum": [
              "Unity / Campouts",
              "Workshops / Speakers",
              "Area / Service",
              "Other"
            ]
          },
          "eventDate": {
            "$ref": "common.defs.json#/$defs/verifiableDate"
          },
          "eventEndDate": {
            "type": "string",
            "format": "date"
          },
          "alt": {
            "$ref": "common.defs.json#/$defs/safeText"
          },
          "src": {
            "type": "string",
            "pattern": "^(flyers/[a-z0-9-]+\\.(png|jpe?g|svg|pdf)|data:(image/(png|jpeg|svg\\+xml)|application/pdf)[;,])"
          },
          "placeholder": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "heading",
              "subheading",
              "color"
            ],
            "properties": {
              "heading": {
                "type": "string",
                "maxLength": 40
              },
              "subheading": {
                "type": "string",
                "maxLength": 60
              },
              "note": {
                "type": "string",
                "maxLength": 60
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              }
            }
          },
          "archivedOn": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
