{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/alexgaard787/bouldertree/main/platforms/ca-regional/data/schema/struggles-payload.schema.json",
  "title": "Group Struggles & Website Ideas submission payload",
  "description": "Identity-free payload sent by the Group Struggles form to the triage webhook (endpoint [VERIFY]). There are no name, email, phone, IP, or device fields, and additionalProperties is false. Free text is screened client-side and must not contain emails or phone numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "scope", "groupOrArea", "topics", "details", "urgency", "followUp", "routing", "submittedMonth"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "group-struggles" },
    "scope": { "type": "string", "pattern": "^(region|group:[a-z0-9-]+)$" },
    "groupOrArea": { "anyOf": [ { "type": "null" }, { "type": "string", "$ref": "common.defs.json#/$defs/safeText", "maxLength": 120 } ] },
    "topics": { "type": "array", "uniqueItems": true, "items": { "enum": ["attendance", "flyers", "directory", "unity", "other"] } },
    "details": { "type": "string", "maxLength": 2000, "not": { "anyOf": [
      { "pattern": "[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}" },
      { "pattern": "\\(?\\d{3}\\)?[\\s.\\-]?\\d{3}[\\s.\\-]?\\d{4}" } ] } },
    "urgency": { "enum": ["routine", "soon", "urgent"] },
    "followUp": { "enum": ["internet-chair", "unity", "hotline-hi-pi-pr", "no-reply"] },
    "routing": {
      "type": "object", "additionalProperties": false, "required": ["primary", "all", "replyRequested"],
      "properties": {
        "primary": { "$ref": "#/$defs/route" },
        "all": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/route" } },
        "replyRequested": { "type": "boolean" }
      }
    },
    "submittedMonth": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$", "description": "Month bucket only; no timestamp." }
  },
  "$defs": {
    "route": { "enum": ["internet-chair", "unity-area-liaisons", "hotline-hi-pi", "council-service-log"] }
  }
}
